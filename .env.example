# Copy file này thành `.env` rồi điền giá trị thật từ Supabase Dashboard
# (Project Settings → API). anon key là public, an toàn để lộ phía client,
# nhưng vẫn để trong .env (không hardcode) cho dễ đổi giữa các project (dev/prod).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
